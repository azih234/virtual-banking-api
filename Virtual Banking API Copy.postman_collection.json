        {
          "name": "Create Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();\r\n\r\npm.environment.set(\r\n    \"accountId\",\r\n    jsonData.accountId\r\n);\r\n\r\nconsole.log(\r\n    \"Saved accountId:\",\r\n    jsonData.accountId\r\n);\r\n\r\npm.test(\"Account created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Account ID returned\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.accountId).to.exist;\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"accountName\": \"{{accountName}}\",\r\n  \"accountType\": \"{{accountType}}\"\r\n}",
